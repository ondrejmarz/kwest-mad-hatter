# Firebase Web app configuration (these are public client keys, safe to ship).
# Copy to `.env` and fill in from the Firebase console for `npm run dev:cloud`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# When true, the app connects to local emulators instead of the cloud project.
# `npm run dev` sets this; leave it out (or set to false) for `npm run dev:cloud`.
VITE_USE_EMULATORS=true
