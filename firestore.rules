rules_version = '2';

// Authorization for the whole app lives here (spec 11) — there is no backend. The key
// trick: get()/exists() inside a rule read documents the client itself cannot, so codes
// and PINs are verified without ever being exposed.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function memberRef(t) {
      return /databases/$(database)/documents/turnuses/$(t)/members/$(uid());
    }
    function isMember(t) { return signedIn() && exists(memberRef(t)); }
    function isAdmin(t) { return isMember(t) && get(memberRef(t)).data.role == 'admin'; }

    function codes(t) {
      return get(/databases/$(database)/documents/turnuses/$(t)/private/config).data;
    }
    function joinAttemptRef(t) {
      return /databases/$(database)/documents/turnuses/$(t)/joinAttempts/$(uid());
    }
    function joinCode(t) { return get(joinAttemptRef(t)).data.code; }

    function ownerIndexRef(t) {
      return /databases/$(database)/documents/turnuses/$(t)/ownerIndex/$(uid());
    }
    function hasPlayer(t) { return signedIn() && exists(ownerIndexRef(t)); }
    function myPlayerId(t) { return get(ownerIndexRef(t)).data.playerId; }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function dayUnlocked(t) {
      return get(/databases/$(database)/documents/turnuses/$(t)).data.get('dayLocked', false) == false;
    }

    function taskRef(t, taskId) {
      return /databases/$(database)/documents/turnuses/$(t)/tasks/$(taskId);
    }
    // A same-day pick (spec 7): the player sets only their own `activeTask` (and clears needsPick)
    // while the day is open. Only a solo task (maxPlayers <= 1) may be taken this way — pairs and
    // groups are reservation-only. The stored coin values must equal the catalog task's, so a client
    // cannot hand itself a fatter reward that day evaluation would then pay out.
    function picksTaskNow(t) {
      let at = request.resource.data.activeTask;
      return onlyChanged(['activeTask', 'needsPick'])
        && request.resource.data.needsPick == false
        && at.taskId is string
        && dayUnlocked(t)
        && exists(taskRef(t, at.taskId))
        && get(taskRef(t, at.taskId)).data.active == true
        && get(taskRef(t, at.taskId)).data.maxPlayers <= 1
        && at.coinReward == get(taskRef(t, at.taskId)).data.coinReward;
    }

    // Accepting a same-day pair pick (spec 7): the invited partner is the only writer, so they set
    // BOTH members' `activeTask` — `pid` is the doc being written (the initiator's or their own).
    // Allowed only against a real claim that invited them for this task, with the catalog coins, so a
    // player can never hand someone else an arbitrary task.
    function picksPairTask(t, pid) {
      let at = request.resource.data.activeTask;
      let day = get(/databases/$(database)/documents/turnuses/$(t)).data.currentDay;
      let claimPath = /databases/$(database)/documents/turnuses/$(t)/taskClaims/$(string(day) + '_' + at.taskId);
      return onlyChanged(['activeTask', 'needsPick'])
        && request.resource.data.needsPick == false
        && dayUnlocked(t)
        && exists(claimPath)
        && get(claimPath).data.invitee == myPlayerId(t)
        && (get(claimPath).data.playerId == pid || get(claimPath).data.invitee == pid)
        && at.taskId == get(claimPath).data.taskId
        && at.coinReward == get(taskRef(t, at.taskId)).data.coinReward;
    }

    // A device claims a character by adding its uid to `ownerUids`. Every claim — even the first
    // on an empty character — needs a claimAttempt whose PIN matches, so nobody grabs the wrong
    // character (spec 3b, 11).
    function pinMatches(t, pid) {
      return exists(/databases/$(database)/documents/turnuses/$(t)/claimAttempts/$(uid()))
        && get(/databases/$(database)/documents/turnuses/$(t)/claimAttempts/$(uid())).data.pin
           == get(/databases/$(database)/documents/turnuses/$(t)/players/$(pid)/private/auth).data.recoveryPin;
    }
    function claimsOwnership(t, pid) {
      return onlyChanged(['ownerUids'])
        && resource.data.status == 'approved'
        && uid() in request.resource.data.ownerUids
        && request.resource.data.ownerUids == resource.data.ownerUids.concat([uid()])
        && pinMatches(t, pid);
    }
    // One device owns one character: claiming a new one releases the old by removing only its
    // own uid (no PIN needed to leave a character you already hold).
    function releasesOwnership(t, pid) {
      return onlyChanged(['ownerUids'])
        && uid() in resource.data.ownerUids
        && request.resource.data.ownerUids == resource.data.ownerUids.removeAll([uid()]);
    }
    // An invited player sets or flips only their own answer in the reservation's `responses`
    // map (spec 7); they must be one of the invited, and may touch no other field or key.
    function respondsToInvite(t, pid) {
      return hasPlayer(t)
        && myPlayerId(t) in resource.data.invitees
        && onlyChanged(['responses'])
        && request.resource.data.responses.diff(resource.data.responses)
             .affectedKeys().hasOnly([myPlayerId(t)]);
    }

    // Global catalog templates — read-only for clients; copied into a turnus by admins.
    match /catalogTasks/{id} { allow read: if signedIn(); allow write: if false; }
    match /catalogRewards/{id} { allow read: if signedIn(); allow write: if false; }

    match /turnuses/{t} {
      // The turnus doc is public (listing + entry). Codes are in private/config, never here.
      allow read: if signedIn();
      allow create: if false; // turnuses are provisioned by seed/console
      allow update: if isAdmin(t);
      allow delete: if false;

      // Codes: no client ever reads them; rules read via get(). An admin may set them.
      match /private/{doc} {
        allow read: if false;
        allow write: if isAdmin(t);
      }

      // Membership is rules-only. Role is derived from which code the joinAttempt matched;
      // the same rule upgrades a player to admin with a valid admin joinAttempt. Stepping DOWN from
      // admin to player needs no code — reducing your own privileges is always safe (spec 3c).
      match /members/{u} {
        allow read: if false;
        allow create: if signedIn() && uid() == u && exists(joinAttemptRef(t))
          && ((request.resource.data.role == 'player' && joinCode(t) == codes(t).playerCode)
            || (request.resource.data.role == 'admin' && joinCode(t) == codes(t).adminCode));
        allow update: if signedIn() && uid() == u
          && (
            (exists(joinAttemptRef(t))
              && ((request.resource.data.role == 'player' && joinCode(t) == codes(t).playerCode)
                || (request.resource.data.role == 'admin' && joinCode(t) == codes(t).adminCode)))
            || (resource.data.role == 'admin'
              && request.resource.data.role == 'player'
              && onlyChanged(['role']))
          );
        allow delete: if false;
      }

      // Only the owner reads their own role; it must mirror the members doc committed alongside it.
      match /roles/{u} {
        allow read: if signedIn() && uid() == u;
        allow create, update: if signedIn() && uid() == u
          && request.resource.data.role == getAfter(memberRef(t)).data.role;
        allow delete: if false;
      }

      // Code check happens here: a wrong code cannot even create the attempt.
      match /joinAttempts/{u} {
        allow read: if false;
        allow create: if signedIn() && uid() == u
          && (request.resource.data.code == codes(t).playerCode
            || request.resource.data.code == codes(t).adminCode);
        allow update: if false;
        allow delete: if signedIn() && uid() == u;
      }

      // PIN guesses for character recovery; verified against private/auth via get() in a rule.
      match /claimAttempts/{u} {
        allow read: if false;
        allow create, delete: if signedIn() && uid() == u;
        allow update: if false;
      }

      // uid -> playerId reverse index so rules can resolve "my player" without a query.
      // Writable only in lockstep with the matching player's ownerUids.
      match /ownerIndex/{u} {
        allow read: if signedIn() && uid() == u;
        allow create, update: if signedIn() && uid() == u
          && uid() in getAfter(/databases/$(database)/documents/turnuses/$(t)/players/$(request.resource.data.playerId)).data.ownerUids;
        allow delete: if (signedIn() && uid() == u) || isAdmin(t);
      }

      // One-shot full-undo snapshot — admins only, kept off the hot turnus doc.
      match /admin/{doc} {
        allow read, write: if isAdmin(t);
      }

      match /players/{pid} {
        allow read: if isMember(t);
        allow create: if isMember(t)
          && request.resource.data.status == 'pending'
          && request.resource.data.coins == 0
          && request.resource.data.needsPick == false
          && request.resource.data.activeTask == null
          && request.resource.data.ownerUids.size() == 0
          && request.resource.data.createdByUid == uid()
          && request.resource.data.name is string;
        // A player never changes their own coins/status — only claims/releases a character, takes a
        // solo task for today (their own doc), or, as the invited partner of a pair pick, hands the
        // task to both members. Coins are always validated against the catalog.
        allow update: if isAdmin(t)
          || (isMember(t) && (claimsOwnership(t, pid) || releasesOwnership(t, pid)))
          || (hasPlayer(t) && pid == myPlayerId(t) && picksTaskNow(t))
          || (hasPlayer(t) && picksPairTask(t, pid));
        // Reject a pending character (spec 9.4); approved players are never hard-deleted.
        allow delete: if isAdmin(t) && resource.data.status == 'pending';

        // Recovery PIN: unreadable by everyone (even the owner); rules compare it via get().
        match /private/auth {
          allow read: if false;
          allow create: if isMember(t);
          allow update, delete: if isAdmin(t);
        }
      }

      match /tasks/{id} { allow read: if isMember(t); allow write: if isAdmin(t); }
      match /rewards/{id} { allow read: if isMember(t); allow write: if isAdmin(t); }

      // Reservations are secret: readable only by the initiator, the invited players and admins.
      // A locked day freezes them (players can't reserve, answer or cancel until evaluation);
      // admins still write them — the undo transaction restoring the pre-evaluation snapshot (A4).
      match /reservations/{pid} {
        allow read: if isAdmin(t)
          || (hasPlayer(t) && (pid == myPlayerId(t) || myPlayerId(t) in resource.data.invitees));
        allow create: if (hasPlayer(t) && pid == myPlayerId(t) && dayUnlocked(t)) || isAdmin(t);
        allow update: if (hasPlayer(t) && dayUnlocked(t)
            && (pid == myPlayerId(t) || respondsToInvite(t, pid)))
          || isAdmin(t);
        allow delete: if (hasPlayer(t) && pid == myPlayerId(t) && dayUnlocked(t)) || isAdmin(t);
      }

      // Public aggregate interest — counts only, no names (spec 7). Cosmetic, so member-trusted.
      match /reservationCounts/{day} {
        allow read: if isMember(t);
        allow write: if isMember(t);
      }

      // Sealed auction bids are secret: readable only by the bidder and admins (spec 8). A bid is a
      // purchase, so placing or raising one is frozen while the day is locked; withdrawing stays
      // open. Admins may write them too — evaluation deletes them, and undo restores them (A4).
      match /rewardBids/{pid} {
        allow read: if isAdmin(t) || (hasPlayer(t) && pid == myPlayerId(t));
        allow create, update: if (hasPlayer(t) && pid == myPlayerId(t) && dayUnlocked(t)) || isAdmin(t);
        allow delete: if (hasPlayer(t) && pid == myPlayerId(t)) || isAdmin(t);
      }

      // Public aggregate interest per reward — a count only, no bidders or amounts (spec 8).
      match /rewardBidCounts/{day} {
        allow read: if isMember(t);
        allow write: if isMember(t);
      }

      // Public live per-target punishment tally — a count only, no bidders, so a target can be
      // greyed out once it reaches the cap. Kept honest at evaluation, so member-writable (spec 8).
      match /punishTargetCounts/{day} {
        allow read: if isMember(t);
        allow write: if isMember(t);
      }

      // First-come marker for a same-day task pick (spec 7): create-only per (day, task), so the
      // first writer wins the task for the day. A solo claim binds the task to its player; a pair
      // claim also names an `invitee` and stays `accepted: false` until they confirm. The paired
      // activeTask writes are checked by `picksTaskNow` / `picksPairTask`. Admin may clear any.
      match /taskClaims/{id} {
        allow read: if isMember(t);
        allow create: if hasPlayer(t)
          && request.resource.data.playerId == myPlayerId(t)
          && dayUnlocked(t);
        // Either member releases the claim — the initiator switching or cancelling, the invitee
        // declining — freeing the task; admins may clear any.
        allow delete: if isAdmin(t)
          || (hasPlayer(t) && dayUnlocked(t)
              && (resource.data.playerId == myPlayerId(t)
                  || resource.data.get('invitee', '') == myPlayerId(t)));
        // The invited partner accepts by flipping only `accepted` to true.
        allow update: if isAdmin(t)
          || (hasPlayer(t) && resource.data.get('invitee', '') == myPlayerId(t)
              && onlyChanged(['accepted']) && request.resource.data.accepted == true);
      }

      // Owned rewards: created by day evaluation and removed by undo — both run as admin. Members
      // read them for the "has a reward" chip (spec 8).
      match /purchases/{id} {
        allow read: if isMember(t);
        allow write: if isAdmin(t);
      }

      // Append-only public audit log.
      match /events/{id} {
        allow read: if isMember(t);
        allow create: if isMember(t);
        allow update, delete: if false;
      }
    }
  }
}
